<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="calculate first 10 number"/>
        <attribute name="authors" value="windows"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-07-22 10:46:10 PM"/>
        <attribute name="created" value="d2luZG93cztERVNLVE9QLTVOS1FIOFQ7MjAyNS0wNy0yMjsxMDozODowMiBQTTszMTM5"/>
        <attribute name="edited" value="d2luZG93cztERVNLVE9QLTVOS1FIOFQ7MjAyNS0wNy0yMjsxMDo0NjoxMCBQTTsxOzMyNDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, sum" type="Integer" array="False" size=""/>
            <assign variable="i" expression="1"/>
            <assign variable="sum" expression="0"/>
            <while expression="i&lt;=10">
                <assign variable="sum" expression="sum+i"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
